      <div className="xl:col-span-8 bg-[#0d1322] border border-slate-800 rounded-xl overflow-hidden shadow-lg flex flex-col">
        <div className="p-3 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <BarChart2 className="w-4 h-4 text-emerald-400" />
            <span className="text-xs font-bold uppercase tracking-wider text-slate-200">Chart • {stockMeta.code}</span>
          </div>
        </div>
        {renderInteractiveChart()}
      </div>

      <div className="xl:col-span-4 bg-[#0d1322] border border-slate-800 rounded-xl overflow-hidden shadow-lg flex flex-col">
        <div className="p-3 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <BookOpen className="w-4 h-4 text-emerald-400" />
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-200">Order Book • {stockMeta.code}</h3>
          </div>
        </div>
        <div className="divide-y divide-slate-800 font-mono text-xs flex-1 p-2">
          {orderBook.bids.map((b, idx) => (
            <div key={idx} className="flex justify-between py-1 px-2 hover:bg-slate-800/40">
              <span className="text-emerald-400 font-bold">{formatNumber(b.price)}</span>
              <span className="text-slate-300">{formatNumber(b.lot)} Lot</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

  {showApiModal && (
    <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-[#0f1629] border border-slate-700 rounded-2xl max-w-md w-full p-5 space-y-4">
        <div className="flex items-center justify-between border-b border-slate-800 pb-3">
          <h3 className="text-sm font-bold text-white">Konfigurasi RapidAPI</h3>
          <button onClick={() => setShowApiModal(false)} className="text-slate-400 hover:text-white"><X className="w-4 h-4" /></button>
        </div>
        <div className="space-y-3 text-xs">
          <div>
            <label className="block text-slate-300 font-semibold mb-1">X-Rapidapi-Key</label>
            <input type="password" value={apiConfig.rapidApiKey} onChange={(e) => setApiConfig({ ...apiConfig, rapidApiKey: e.target.value })} className="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono outline-none" />
          </div>
          <div>
            <label className="block text-slate-300 font-semibold mb-1">X-Rapidapi-Host</label>
            <input type="text" value={apiConfig.rapidApiHost} onChange={(e) => setApiConfig({ ...apiConfig, rapidApiHost: e.target.value })} className="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono outline-none" />
          </div>
          <div>
            <label className="block text-slate-300 font-semibold mb-1">Days Parameter</label>
            <input type="number" value={apiConfig.days} onChange={(e) => setApiConfig({ ...apiConfig, days: Number(e.target.value) })} className="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono outline-none" />
          </div>
          <button onClick={() => { setShowApiModal(false); fetchRapidApiData(selectedCode); }} className="w-full py-2.5 rounded-xl bg-emerald-500 text-slate-950 font-extrabold">
            Simpan & Fetch Data
          </button>
        </div>
      </div>
    </div>
  )}
</div>


);
}
