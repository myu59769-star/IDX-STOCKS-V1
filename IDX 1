const TIMEFRAME_CONFIG = {
'1m': { label: '1m', stepMin: 1, volMult: 1 },
'5m': { label: '5m', stepMin: 5, volMult: 3.5 },
'15m': { label: '15m', stepMin: 15, volMult: 8 },
'1H': { label: '1H', stepMin: 60, volMult: 22 },
'1D': { label: '1D', stepMin: 1440, volMult: 180 }
};

function generateAnchoredCandles(targetClose, tickSize, tfKey = '5m', count = 58) {
const tf = TIMEFRAME_CONFIG[tfKey] || TIMEFRAME_CONFIG['5m'];
const rawChanges = [];
for (let i = 0; i < count; i++) {
const seed = Math.sin((i + 1) * 12.9898 + targetClose * 0.001) * 43758.5453;
const frac = seed - Math.floor(seed);
const step = Math.round((frac - 0.48) * 3) * tickSize;
rawChanges.push(step);
}

const candles = new Array(count);
let priceCursor = targetClose;
const now = Date.now();

for (let i = count - 1; i >= 0; i--) {
const time = new Date(now - (count - 1 - i) * tf.stepMin * 60000);
const timeStr = tf.stepMin >= 1440 ? time.toISOString().slice(5, 10) : time.toTimeString().slice(0, 5);

const close = i === count - 1 ? targetClose : priceCursor;
const open = Math.max(tickSize * 5, close - rawChanges[i]);
const bodySpread = Math.max(tickSize, Math.abs(close - open));
const high = Math.max(open, close) + Math.max(tickSize, Math.round(bodySpread * 0.65));
const low = Math.max(tickSize * 2, Math.min(open, close) - Math.max(tickSize, Math.round(bodySpread * 0.65)));
const volume = Math.floor((3500 + ((i * 1973) % 11000)) * tf.volMult);
const isBull = close >= open;

candles[i] = {
  time: timeStr,
  open: close === open ? open - tickSize : open,
  high,
  low,
  close,
  volume,
  hakaVol: isBull ? Math.floor(volume * 0.66) : Math.floor(volume * 0.34)
};
priceCursor = open;


}
return candles;
}

