      ok: true,
      latency: `${Math.round(performance.now() - startTime)} ms`,
      url: `GET /api/v1/picks/${symbol}?days=${days}`,
      detail: `[RAPIDAPI SUCCESS] ${symbol}: Rp ${formatNumber(liveClose)}`,
      rawPreview: JSON.stringify(json).slice(0, 260)
