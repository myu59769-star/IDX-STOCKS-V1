const fetchRapidApiData = async (tickerSymbol = selectedCode) => {
setIsFetchingRapidApi(true);
const startTime = performance.now();
const symbol = tickerSymbol.toUpperCase().trim();
const days = apiConfig.days || 30;

const endpointUrl = `https://${apiConfig.rapidApiHost}/api/v1/picks/${symbol}?days=${days}`;
const corsProxies = [
  endpointUrl,
  `https://corsproxy.io/?${encodeURIComponent(endpointUrl)}`,
  `https://api.allorigins.win/raw?url=${encodeURIComponent(endpointUrl)}`
];

for (const url of corsProxies) {
  try {
    const res = await fetch(url, {
      method: 'GET',
      headers: {
        'X-Rapidapi-Key': apiConfig.rapidApiKey,
        'X-Rapidapi-Host': apiConfig.rapidApiHost,
        'Accept': 'application/json'
      }
    });

    if (!res.ok) continue;
    const json = await res.json();
    
    // Ambil data pick atau harga dari response RapidAPI
    const picksArray = json?.picks || json?.data || (Array.isArray(json) ? json : null);
    const latestPick = Array.isArray(picksArray) && picksArray.length > 0 ? picksArray[picksArray.length - 1] : null;

    const liveClose = Number(latestPick?.close || latestPick?.price || stockMeta.basePrice || 4860);
    const tick = getIdxTickSize(liveClose);
    const liveOpen = Number(latestPick?.open || liveClose);
    const liveHigh = Number(latestPick?.high || Math.max(liveClose, liveOpen));
    const liveLow = Number(latestPick?.low || Math.min(liveClose, liveOpen));

    lockedRealPricesRef.current[symbol] = {
      close: liveClose,
      open: liveOpen,
      high: liveHigh,
      low: liveLow,
      tickSize: tick,
      syncedAt: new Date().toTimeString().slice(0, 8)
    };

    setCurrentPrice(liveClose);
    setDayHigh(liveHigh);
    setDayLow(liveLow);
    setActiveDataSource(`RapidAPI (${apiConfig.rapidApiHost})`);
    generateOrderBook(liveClose, tick);
    setCandles(generateAnchoredCandles(liveClose, tick, timeframe));

    appendNetworkLog({
      service: 'RapidAPI IDX Screener',
